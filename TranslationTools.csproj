<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Alpha. The four-part number is the release tag; bump it with each release. -->
    <Version>0.1.0.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>Translation Tools</Product>
    <Company>Taloreal</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="lib\TALOREAL_NETCORE_API\TALOREAL_NETCORE_API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library is a submodule under lib\ and is built through the reference above;
         its sources must not also be swept into this project by the default glob. -->
    <Compile Remove="lib\**" />
    <None Remove="lib\**" />
    <EmbeddedResource Remove="lib\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The user manual ships beside the exe. -->
    <None Include="MANUAL.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The compiler installer ships beside the exe so the tool can run it on a fresh machine. -->
    <None Include="Scripts\Update-SiglusSsu.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Scripts\Update-SiglusSsu.bat" CopyToOutputDirectory="PreserveNewest" />
    <!-- The bundled NScripter engine (ONScripter-EN, GPL) ships beside the exe, with its license.
         It is a separate program the tool starts, so a single-file publish must leave it as loose
         files: bundled into the exe it could neither be started nor seen with its license. -->
    <None Include="Tools\ONScripter\**" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- The compiler installer is run by PowerShell, so it stays loose as well. -->
    <None Update="Scripts\Update-SiglusSsu.ps1" ExcludeFromSingleFile="true" />
    <None Update="Scripts\Update-SiglusSsu.bat" ExcludeFromSingleFile="true" />
    <None Update="MANUAL.md" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
