<?xml version="1.0" encoding="utf-8"?>
<!-- A machine whose global NuGet config maps packages to sources by name blocks the
     runtime packs a self-contained publish needs, since nothing maps them. Mappings merge
     across config files, so this one adds the runtime packs to nuget.org for this repo
     only; a machine with no mapping at all is unaffected. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.NETCore.App.Runtime.*" />
      <package pattern="Microsoft.NETCore.App.Host.*" />
      <package pattern="Microsoft.AspNetCore.App.Runtime.*" />
      <package pattern="Microsoft.WindowsDesktop.App.Runtime.*" />
      <package pattern="Microsoft.NET.ILLink.Tasks" />
      <package pattern="Microsoft.DotNet.ILCompiler" />
      <package pattern="runtime.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
