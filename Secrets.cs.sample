// File: Secrets.cs.sample
// Namespace: TranslationTools
//
// Copy this file to Secrets.cs and fill in the values. The .sample name keeps it
// out of the build; Secrets.cs is ignored by git, so both values are compiled
// into the tool but never committed. Anyone who builds from source points the
// tool at their own service with their own key.
namespace TranslationTools {

	/// <summary>
	/// Values that are compiled in but never committed: where the build-mode service
	/// lives and the key reports are signed with. Neither appears anywhere public, so
	/// finding the service means reading the tool, not probing the host.
	/// </summary>
	public static class Secrets {

		/// <summary>
		/// The report_key from the build-mode service's config.php. Never sent; each
		/// report is signed with it.
		/// </summary>
		public const string ReportKey = "";

		/// <summary>
		/// The folder the service's lookup.php and report.php live in, no trailing slash.
		/// </summary>
		public const string ServiceUrl = "";
	}
}
